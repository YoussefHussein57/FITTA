{
  "name": "fitta",
  "version": "0.0.0",
  "private": true,
  "description": "FITTA — Egyptian-first fitness and nutrition platform",
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm --recursive --sequential run build",
    "typecheck": "pnpm --recursive --sequential run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --recursive run test",
    "test:integration": "pnpm --filter @fitta/api run test:integration",
    "test:e2e": "pnpm --filter @fitta/web run test:e2e",
    "check:repo": "node scripts/check-repo-invariants.mjs",
    "verify": "pnpm run format:check && pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run check:repo && pnpm run test",
    "clean": "pnpm --recursive run clean",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:ps": "docker compose ps",
    "db:migrate": "pnpm --filter @fitta/api run db:migrate",
    "db:deploy": "pnpm --filter @fitta/api run db:deploy",
    "db:status": "pnpm --filter @fitta/api run db:status",
    "env:check": "pnpm --filter @fitta/api run env:check",
    "//DESTRUCTIVE": "The commands below delete data. They are never invoked by any other script (acceptance case 11).",
    "db:nuke:DESTRUCTIVE": "docker compose down -v"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fitta/config": "workspace:*",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
