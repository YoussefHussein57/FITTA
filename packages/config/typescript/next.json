{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "FITTA Next.js application",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowJs": true,
    "isolatedModules": true,

    // Next compiles with SWC; tsc is used purely as a type checker here.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,

    "plugins": [{ "name": "next" }]
  }
}
