{
  "name": "@fitta/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared API schemas and types — the single source of truth for the FITTA API contract",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('tsconfig.tsbuildinfo',{force:true})\""
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fitta/config": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
