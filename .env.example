# FITTA — example configuration.
#
# Copy to apps/api/.env and adjust. Never commit a real .env (docs/SECURITY.md §5).
# Every key below is validated at boot by apps/api/src/config/env.ts; the process
# refuses to start if any is missing or malformed.

# development | test | production
NODE_ENV=development

# Port the NestJS API listens on.
PORT=3001

# PostgreSQL connection string.
# 5433 is the Docker dev instance from docker-compose.yml; the test instance is
# on 5435. Neither is 5432, which a locally installed PostgreSQL occupies.
DATABASE_URL=postgresql://fitta:fitta_dev_password@localhost:5433/fitta_dev?schema=public

# Origin permitted to call the API directly. The browser normally reaches the API
# through the Next.js proxy and is same-origin, so this covers deliberate direct
# access only (docs/DECISIONS.md ADR-007).
WEB_ORIGIN=http://localhost:3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# apps/web  →  copy to apps/web/.env.local
# -----------------------------------------------------------------------------

# Where the Next.js server reaches the API, for server-side fetches and for the
# /api/* rewrite in next.config.ts.
#
# NOT prefixed NEXT_PUBLIC_, deliberately. Anything with that prefix is inlined
# into the browser bundle and is public. The browser calls the relative /api path
# and never learns the API's real origin (docs/DECISIONS.md ADR-007).
API_BASE_URL=http://localhost:3001
